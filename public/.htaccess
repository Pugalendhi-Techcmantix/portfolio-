# Apache config for the portfolio (cPanel / shared hosting).
# Vite copies this file into dist/, so it is uploaded together with the site.

Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # --- Force HTTPS -------------------------------------------------------
  # Enable these two lines only AFTER https://your-domain works (cPanel > SSL/TLS Status > Run AutoSSL),
  # otherwise visitors get redirected to a broken https page.
  # RewriteCond %{HTTPS} !=on
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # --- Single-page app fallback -----------------------------------------
  # Real files and folders are served as-is.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  # Missing build files should 404, not return the page.
  RewriteRule ^assets/ - [L,R=404]
  # Every other path loads the app.
  RewriteRule ^ index.html [L]
</IfModule>

# --- Correct types for fonts and modules ----------------------------------
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType application/javascript .js .mjs
  AddType image/svg+xml .svg
</IfModule>

# --- Compression ------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# --- Caching ----------------------------------------------------------------
<IfModule mod_headers.c>
  # Hashed build files never change: cache for a year.
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # The page itself is always revalidated so new uploads show immediately.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # --- Security headers ---------------------------------------------------
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
